{
  "family": "evolution-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "${aws_iam_role.ecs_task_execution_role.arn}",
  "containerDefinitions": [
    {
      "name": "evolution-api",
      "image": "${aws_ecr_repository.evolution_api.repository_url}:latest",
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],
      "essential": true,
      "environment": [
        { "name": "WHATSAPP_NUMBER", "value": "${var.whatsapp_number}" },
        { "name": "WEBHOOK_PATH", "value": "/evolution" }
      ]
    }
  ]
}