{
  "family": "redis",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "${aws_iam_role.ecs_task_execution_role.arn}",
  "containerDefinitions": [
    {
      "name": "redis",
      "image": "redis:6-alpine",
      "portMappings": [
        { "containerPort": 6379, "protocol": "tcp" }
      ],
      "essential": true
    }
  ]
}